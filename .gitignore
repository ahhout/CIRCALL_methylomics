# CIRCALL project: configuration, samplesheets and general metadata stay trackable.
# Ignore generated payloads, runtime state, installed tools and credentials.
# Previously committed historical provenance remains tracked; ignore rules do
# not remove files from Git. Keep the explicit archive/provenance exceptions.


# Nextflow execution state and reports
.nextflow/
.nextflow.log*
/work/
/results/
/output/
/outputs/
/publish/
/reports/
/timeline*.html
/report*.html
/trace*.txt
/dag*.html
/dag*.dot
slurm-*.out

# Containers and caches
.apptainer/
.singularity/
apptainer/
singularity/
*.sif
*.simg

# Raw sequencing data and temporary inputs
/scratch/
/tmp/
/raw/
/data/
/inputs/
*.fastq
*.fq
*.fastq.gz
*.fq.gz
*.bam
*.sam
*.bai
*.cram
*.crai

# Methylation output files
*.bedGraph
*.cov
*.CX_report.txt
*.M-bias.txt
*.splitting_report.txt
*.deduplication_report.txt

# Editor and interpreter caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
*~
*.swp

