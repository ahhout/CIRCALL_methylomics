// Flamingo runtime only. Scientific parameters are in params.{uxm,epidish}.json.
def runtime = System.getenv('DECONFLOW_RUNTIME')
def genome = System.getenv('DECONFLOW_GENOME')

process {
    executor = 'slurm'
    queue = { task.time <= 6.h ? 'shortq' : task.time <= 24.h ? 'mediumq' : 'longq' }
    errorStrategy = 'terminate'
    maxRetries = 0
    beforeScript = 'mkdir -p .tmp'
    containerOptions = { '--bind ' + task.workDir + '/.tmp:/tmp --bind ' + runtime + '/references:/opt/wgbstools/references:ro --bind ' + genome + ':' + genome + ':ro --env TMPDIR=/tmp --env SLURM_JOB_CPUS_PER_NODE=' + task.cpus }
    withLabel: process_low { cpus = 2; memory = '4 GB'; time = '2h' }
    withLabel: process_medium { cpus = 4; memory = '16 GB'; time = '6h' }
    withLabel: process_high { cpus = 8; memory = '32 GB'; time = '24h' }
    withName: '.*BAM2PAT.*' {
        container = "${runtime}/images/uxm.sif"
        // This module sets its own bind; override it explicitly too.
        containerOptions = { '--bind ' + task.workDir + '/.tmp:/tmp --bind ' + runtime + '/references:/opt/wgbstools/references:ro --bind ' + genome + ':' + genome + ':ro --env TMPDIR=/tmp --env SLURM_JOB_CPUS_PER_NODE=' + task.cpus }
        publishDir = []
        time = '48h'
    }
    withName: '.*UXM_DECONV' { container = "${runtime}/images/uxm.sif" }
    withName: '.*EPIDISH' { container = "${runtime}/images/epidish.sif" }
    withName: '.*TEST_PREPROCESSING' { container = "${runtime}/images/preprocessing.sif" }
    withName: '.*(PROCESS_REF_MATRIX|MERGE_SAMPLES|COMBINE_FILES)' { container = "${runtime}/images/python.sif" }
}
executor { queueSize = 4; submitRateLimit = '1/1s' }
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,peak_rss,workdir'
apptainer { enabled = true; autoMounts = true; cacheDir = '/path/to/hpc-scratch/nextflow/apptainer_cache' }
env {
    TMPDIR = '/tmp'
    TZ = 'UTC'
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    http_proxy = 'http://127.0.0.1:9'
    https_proxy = 'http://127.0.0.1:9'
    HTTP_PROXY = 'http://127.0.0.1:9'
    HTTPS_PROXY = 'http://127.0.0.1:9'
    NO_PROXY = 'localhost,127.0.0.1'
    no_proxy = 'localhost,127.0.0.1'
}
cleanup = false
