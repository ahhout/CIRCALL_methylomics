// Publish the unchanged upstream module outputs using the existing result schema.
def resultRoot = params.outdir
def traceSuffix = params.trace_report_suffix
process {
    withName: FRAGMENT_COUNTS {
        container = "${System.getenv('DECONFLOW_RUNTIME')}/images/uxm.sif"
        publishDir = [path: "${resultRoot}/fragment_counts", mode: 'copy']
    }
    withName: UXM_DECONV {
        publishDir = [path: "${resultRoot}/deconvolution_results/reference_based/uxm", mode: 'copy']
    }
}
trace {
    enabled = true
    overwrite = true
    file = "${resultRoot}/pipeline_info/execution_trace_${traceSuffix}.txt"
}
