// Scheduling only: scientific parameters and production reference are unchanged.
process {
    queue = 'shortq'
    time = 2.h
    maxRetries = 0
    resourceLimits = [cpus: 4, memory: 32.GB, time: 5.h]
    withName: 'BISMARK_ALIGN' {
        cpus = 3
        memory = 32.GB
        time = 2.h
    }
    withName: 'BISMARK_DEDUPLICATE' { memory = 8.GB }
    withName: 'BISMARK_METHYLATIONEXTRACTOR' {
        cpus = 3
        memory = 12.GB
        time = 2.h
    }
    withName: 'TRIMGALORE' { memory = 4.GB }
    withName: 'SAMTOOLS_SORT' { memory = 8.GB }
}
